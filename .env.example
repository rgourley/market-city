# Your Massive API key. Copy this file to .env.local and fill it in. .env.local is git-ignored.
MASSIVE_API_KEY=

# Minutes to hold back today's newest data. 15 is the usual level for showing market data to the public.
# Set 0 only if your Massive plan allows real-time display to other people.
DISPLAY_DELAY_MINUTES=15

# Set to basic to run on the free Stocks Basic plan (lite mode: one tower per sector, no live view).
MASSIVE_PLAN=
